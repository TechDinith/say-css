{
  "name": "@say-css/core",
  "version": "0.1.0",
  "description": "Say CSS — utility-first CSS library. Simple, fast, modern, zero-config.",
  "type": "module",
  "main": "dist/say.css",
  "style": "dist/say.css",
  "exports": {
    ".": "./dist/say.css",
    "./container-variants.css": "./src/container-variants.css",
    "./jit.css": "./src/jit.css",
    "./vite": "./plugins/vite.mjs"
  },
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "src",
    "scripts",
    "plugins",
    "types"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:jit": "node scripts/jit.mjs",
    "gen:utilities": "node scripts/gen-utilities.mjs",
    "dev": "node scripts/build.mjs",
    "lint": "echo \"lint not yet implemented\""
  },
  "keywords": [
    "css",
    "utility",
    "utility-first",
    "tailwind-alternative",
    "say-css",
    "modern-css",
    "vite",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/say-css/say-css"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.33"
  }
}
